{
  "$schema": "https://turbo.build/schema.json",

  "globalEnv": ["DATABASE_URL"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "lint": {
      "dependsOn": ["^lint"]
    },

    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "clean": {
      "cache": false
    }
  }
}
