{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "NodeNext",
    "paths": {
      "@salon/shared": ["packages/shared/src/index.ts"],
      "@salon/*": [
