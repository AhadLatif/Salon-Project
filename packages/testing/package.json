{
  "name": "@salon/testing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/vitest.config.d.ts",
      "default": "./dist/config/vitest.config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@salon/config": "workspace:*",
    "@salon/database": "workspace:*",
    "@salon/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@salon/typescript-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
