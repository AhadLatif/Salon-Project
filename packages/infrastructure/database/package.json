{
  "name": "@salon/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",

    "db:generate": "node scripts/generate.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://salon_admin:super_secret_password_123@127.0.0.1:5432/salon_test} drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "seed:permissions": "NODE_ENV=development tsx --env-file=../../../.env src/seed/seed-permissions.ts",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@salon/typescript-config": "workspace:*",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@salon/config": "workspace:*",
    "@salon/logger": "workspace:*",
    "@salon/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "uuid": "^14.0.1"
  }
}
