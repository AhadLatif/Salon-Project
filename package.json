{
  "name": "salon-project",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11.5.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test --concurrency=1",
    "test:watch": "vitest",

    "typecheck": "turbo typecheck",
    "format": "biome check --write .",
    "clean": "turbo run clean",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "turbo typecheck && biome check . && pnpm run depcruise",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "depcruise:watch": "depcruise --watch --config .dependency-cruiser.cjs apps packages",
    "depcruise:graph": "pnpm run depcruise:modules:dot && pnpm run depcruise:modules:svg && pnpm run depcruise:modules:png && pnpm run depcruise:dot && pnpm run depcruise:svg && pnpm run depcruise:png && pnpm run depcruise:interactive",
    "depcruise:modules:dot": "depcruise --config .dependency-cruiser.cjs --output-type archi --collapse '^packages/(modules|infrastructure)/[^/]+' apps packages > docs/architecture/architecture-modules.dot",
    "depcruise:modules:svg": "depcruise --config .dependency-cruiser.cjs --output-type archi --collapse '^packages/(modules|infrastructure)/[^/]+' apps packages | dot -Tsvg -o docs/architecture/architecture-modules.svg",
    "depcruise:modules:png": "dot -Tpng docs/architecture/architecture-modules.dot -o docs/architecture/architecture-modules.png",
    "depcruise:dot": "depcruise --config .dependency-cruiser.cjs --output-type dot apps packages > docs/architecture/architecture-detailed.dot",
    "depcruise:svg": "depcruise --config .dependency-cruiser.cjs --output-type dot apps packages | dot -Tsvg -o docs/architecture/architecture-detailed.svg",
    "depcruise:png": "dot -Tpng docs/architecture/architecture-detailed.dot -o docs/architecture/architecture-detailed.png",
    "depcruise:interactive": "depcruise --config .dependency-cruiser.cjs --output-type x-dot-webpage -f docs/architecture/architecture-interactive.html apps packages",
    "depcruise:focus": "depcruise --config .dependency-cruiser.cjs --output-type dot --focus \"^packages/modules/\" apps packages > docs/architecture/architecture-focus.dot",
    "depcruise:report": "depcruise --config .dependency-cruiser.cjs --output-type json --output-to depcruise.json apps packages"
  },

  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.0.1",
    "dependency-cruiser": "^18.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
